{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // 🚨 워커 이름은 배포 대상 식별자다. 이 폴더는 반드시 "aisolution-gemini" 로만 배포한다
  //    (본체 "aisolution" 이나 다른 이름으로 바꾸면 그 워커를 덮어쓴다 — 2026-09-07 ilzik.com 사고 참고).
  // 하는 일: Gemini generateContent 중계만. 본체 워커가 서비스 바인딩 GEMINI_PROXY 로 부른다.
  // 배포: 이 폴더에서 `npx wrangler deploy --config wrangler.jsonc` (본체보다 먼저 — 본체의 서비스 바인딩이 이 워커를 가리킨다).
  // 🚨 --config 를 빼면 본체 빌드가 만든 ../../.wrangler/deploy/config.json 과 부딪혀 wrangler 가 멈춘다.
  "name": "aisolution-gemini",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-24",
  // 공개 주소 없음: workers.dev 끔, 라우트·커스텀 도메인 없음. 서비스 바인딩으로만 호출된다.
  "workers_dev": false,
  "preview_urls": false,
  // 실행 위치를 미국 동부(GCP us-east4 와 가장 가까운 데이터센터)로 고정한다.
  // 구글은 요청이 나가는 위치로 지역 차단을 판단하므로, 이 워커가 미국에서 돌면 400 위치 차단을 피한다.
  // 근거: https://developers.cloudflare.com/workers/configuration/placement/#specify-a-cloud-region
  //   형식 "{provider}:{region}" (aws:/gcp:/azure:). wrangler 는 { mode: "targeted", region } 으로 올린다.
  // 🚨 placement 는 fetch 처리기에만 적용된다. src/index.ts 를 RPC(WorkerEntrypoint 메서드)로 바꾸지 마라.
  "placement": { "region": "gcp:us-east4" },
  "observability": { "enabled": true }
}
