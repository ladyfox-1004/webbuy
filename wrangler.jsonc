{
  "$schema": "node_modules/wrangler/config-schema.json",
// 🚨 이름을 템플릿 기본값("tanstack-start-app")으로 두지 마라.
//    같은 템플릿으로 만든 다른 앱(ilzik.com)이 같은 이름을 쓰고 있어서,
//    2026-09-07 에 이 사이트를 배포했다가 ilzik.com 을 통째로 덮어썼다.
//    워커 이름은 그 자체가 배포 대상 식별자다.
  "name": "aisolution",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  // 🚨 `/foo.html` 을 `/foo` 로 307 리다이렉트하지 마라(Workers Assets 기본 동작).
  //    네이버 사이트 소유확인은 파일 경로 그대로 200 을 요구한다.
  "assets": { "html_handling": "none" },
  // 공개 설정값(비밀 아님). 🚨 키(SUPABASE_SERVICE_ROLE_KEY, GEMINI_API_KEY)는 여기 적지 말고
  //    `wrangler secret put` 으로만 넣는다(공개 저장소).
  // 블로그 예약 실행 크론은 vite.config.ts 의 nitro.scheduledTasks 에 있다(빌드 때 triggers 로 들어감).
  "vars": {
    "SUPABASE_URL": "https://fnvvpfunmpigfyqwoeea.supabase.co",
    "BLOG_PLAYLIST_ID": "PLY7xPjoryumg",
    "BLOG_DAILY_LIMIT": "3",
    "GEMINI_MODEL": "gemini-3.8-flash",
    // 블로그 초안의 Gemini 호출을 거치는 Cloudflare AI Gateway 이름(공개 값).
    // GEMINI_PROXY 서비스 바인딩이 없을 때의 대체 경로다(게이트웨이도 400 위치 차단을 못 피했다, 10/25).
    "AI_GATEWAY_ID": "aisolution-blog"
  },
  // Workers AI 바인딩. AI Gateway 를 env.AI.gateway(id).run() 으로 부른다(인증 게이트웨이도 바인딩은 자동 인증).
  // 쓰는 곳: src/lib/blog-automation/gemini.ts generateDraft
  "ai": { "binding": "AI" },
  // Gemini 중계 워커(workers/gemini-proxy, 이름 aisolution-gemini)로 가는 서비스 바인딩.
  // 그 워커만 placement.region 으로 미국에 고정해 구글 위치 차단(400)을 피한다. 본체 실행 위치는 그대로다.
  // 🚨 배포 순서: aisolution-gemini 를 먼저 배포해야 이 바인딩이 붙는다.
  // 쓰는 곳: src/lib/blog-automation/gemini.ts generateDraft (우선순위 GEMINI_PROXY → AI Gateway → 직접)
  "services": [{ "binding": "GEMINI_PROXY", "service": "aisolution-gemini" }],
  // 이 워커가 실제로 나가는 주소. 대시보드에만 두지 마라 —
  // 커스텀 도메인이 리포에 안 보이면 배포할 때 무엇을 덮어쓰는지 알 수 없다
  // (2026-09-07 ilzik.com 사고가 정확히 그 이유로 났다).
  "routes": [
    { "pattern": "ai-solution.co.kr", "custom_domain": true },
    { "pattern": "www.ai-solution.co.kr", "custom_domain": true }
  ]
}
